# GOOGLE_API_KEY=your-key
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_MEMORY_LIMIT=128m
SANDBOX_NANO_CPUS=500000000
MAX_SELF_HEALING_RETRIES=3

# External fixed sandbox pool. Use http://localhost:8100 when AI Core runs on the same host
# as docker compose; use http://<sandbox-host-ip>:8100 from another machine.
SANDBOX_BASE_URL=http://localhost:8100
SANDBOX_REPOSITORY_PATH=/repositories/validate
SANDBOX_HTTP_TIMEOUT_SECONDS=900
